# Copy to .env or let scripts/init-dev-env.py create random local-only secrets.
# app/.env is ignored by Git. NEVER use real AWS, PostgreSQL or SES credentials.
MLO_DEV_PG_PASSWORD=replace-with-random-local-only-password
MLO_DEV_API_SECRET_KEY=replace-with-random-local-only-secret
MLO_DEV_ADS_SECRET_KEY=replace-with-random-local-only-secret
MLO_DEV_ADS_INTERNAL_SECRET=replace-with-random-local-only-secret
MLO_DEV_ADS_SIGNING_KEY=replace-with-random-local-only-secret
