{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlo.local/contracts/runtime-artifact-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_version", "environment", "generation", "platform", "example_only", "target_nodes", "node_roles", "operations", "files", "image_digests", "config_hashes", "required_secrets"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "environment": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "generation": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "platform": {"const": "linux/amd64"},
    "example_only": {"const": false},
    "fixture": {"type": "boolean"},
    "target_nodes": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}},
    "node_roles": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["control", "gateway", "postgresql", "mongodb", "kafka", "spark", "elasticsearch", "advertising"]}},
    "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["install", "deploy", "health", "rollback"]}},
    "files": {"$ref": "#/$defs/hashes"},
    "config_hashes": {"$ref": "#/$defs/hashes"},
    "image_digests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[^\\s]+@sha256:[a-f0-9]{64}$"}},
    "required_secrets": {"type": "object", "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/run/mlo/secrets/[^\\s]+$"}}}
  },
  "$defs": {"hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
}
