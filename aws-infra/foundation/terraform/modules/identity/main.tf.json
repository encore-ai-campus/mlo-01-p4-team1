{
  "terraform": {
    "required_version": "= 1.11.4",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "= 5.94.1"
      }
    }
  },
  "variable": {
    "binding": {
      "type": "any"
    },
    "account": {
      "type": "string"
    }
  },
  "locals": {
    "subjects": "${var.binding.oidc_subjects}"
  },
  "resource": {
    "aws_iam_openid_connect_provider": {
      "github": {
        "count": "${length(local.subjects)>0 ? 1 : 0}",
        "url": "https://token.actions.githubusercontent.com",
        "client_id_list": [
          "sts.amazonaws.com"
        ]
      }
    },
    "aws_iam_role": {
      "ci": {
        "for_each": "${local.subjects}",
        "name": "${\"p4-ci-${each.key}\"}",
        "assume_role_policy": "${jsonencode({Version=\"2012-10-17\",Statement=[{Effect=\"Allow\",Action=\"sts:AssumeRoleWithWebIdentity\",Principal={Federated=aws_iam_openid_connect_provider.github[0].arn},Condition={StringEquals={\"token.actions.githubusercontent.com:aud\"=\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\"=each.value}}}]})}"
      },
      "foundation": {
        "name": "p4-foundation",
        "assume_role_policy": "${jsonencode({Version=\"2012-10-17\",Statement=[{Effect=\"Allow\",Action=\"sts:AssumeRole\",Principal={AWS=var.binding.provisioner_arns[var.account]}}]})}"
      }
    },
    "aws_iam_role_policy": {
      "ci": {
        "for_each": "${local.subjects}",
        "role": "${aws_iam_role.ci[each.key].id}",
        "policy": "${jsonencode(var.binding.ci_policies[each.key])}"
      }
    }
  }
}
