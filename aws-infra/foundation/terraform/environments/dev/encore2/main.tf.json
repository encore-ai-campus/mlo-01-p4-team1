{
  "terraform": {
    "required_version": "= 1.11.4",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "= 5.94.1"
      }
    },
    "backend": {
      "s3": {}
    }
  },
  "variable": {
    "binding": {
      "type": "any",
      "validation": [
        {
          "condition": "${var.binding.region==\"ap-northeast-2\" && length(distinct(values(var.binding.account_ids)))==5 && length(distinct(values(var.binding.az_ids)))==3}",
          "error_message": "Seoul, five accounts and three physical AZs required."
        }
      ]
    }
  },
  "provider": {
    "aws": {
      "region": "ap-northeast-2",
      "allowed_account_ids": "${[var.binding.account_ids.encore2]}",
      "profile": "encore2"
    }
  },
  "module": {
    "account": {
      "source": "../../../modules/account",
      "account": "encore2",
      "binding": "${var.binding}",
      "data_sizes": {
        "control-a": 16,
        "control-b": 16,
        "postgresql": 30,
        "kafka-01": 40,
        "spark-01": 40,
        "elasticsearch-01": 40,
        "kafka-02": 40,
        "spark-02": 40,
        "elasticsearch-02": 40,
        "kafka-03": 40,
        "spark-03": 40,
        "elasticsearch-03": 40,
        "advertising": 16,
        "mongodb": 30,
        "gateway-a": 16,
        "gateway-b": 16
      }
    },
    "identity": {
      "source": "../../../modules/identity",
      "account": "encore2",
      "binding": "${var.binding}"
    }
  },
  "output": {
    "foundation": {
      "value": "${module.account.foundation}"
    },
    "runtime_artifact_boundary": {
      "value": "${module.account.runtime_artifact_boundary}"
    }
  }
}
