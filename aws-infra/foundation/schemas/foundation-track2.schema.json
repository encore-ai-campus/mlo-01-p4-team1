{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundation-only Track2 sidecar; common contract adoption pending",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "foundation-track2/1"
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "example_only": {
      "type": "boolean"
    },
    "region": {
      "const": "ap-northeast-2"
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "enabled": {
      "type": "boolean"
    },
    "dataset_version": {
      "type": "string"
    },
    "driver_queries": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "control-a",
          "control-b"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^venues-[a-z0-9-]+$"
        }
      }
    },
    "ingest_nodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "control-a",
          "control-b"
        ]
      }
    },
    "media_bucket_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "archive_bucket_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "distribution_arn": {
      "type": "string",
      "pattern": "^arn:aws:cloudfront::[0-9]{12}:distribution/[A-Z0-9]+$"
    },
    "tls_status": {
      "enum": [
        "CONFIGURED_NOT_VERIFIED",
        "UNRESOLVED_ORIGIN_NAME_CERTIFICATE",
        "VIEWER_HTTPS_ORIGIN_HTTP"
      ]
    },
    "ready_for_aws": {
      "const": false
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw_venues": {
          "type": [
            "string",
            "null"
          ]
        },
        "lake_venues": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_photos": {
          "type": [
            "string",
            "null"
          ]
        },
        "archive": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoints": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "control-a",
              "control-b"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "raw_venues",
        "lake_venues",
        "approved_photos",
        "archive",
        "checkpoints"
      ]
    }
  },
  "required": [
    "schema_version",
    "environment",
    "generation",
    "example_only",
    "region",
    "inventory_sha256",
    "enabled",
    "dataset_version",
    "driver_queries",
    "ingest_nodes",
    "media_bucket_ref",
    "archive_bucket_ref",
    "distribution_arn",
    "tls_status",
    "ready_for_aws",
    "paths"
  ]
}
